# LanguageLab configuration.
#
# Release: copy this file to ~/.config/language-lab/.env and restrict it to your user:
#   mkdir -p ~/.config/language-lab
#   cp .env.example ~/.config/language-lab/.env
#   chmod 600 ~/.config/language-lab/.env
# Dev: copy it to ./.env at the repo root (gitignored) and set LANGUAGE_LAB_DEV=1 in your shell.
#
# Variables set in the process environment override this file. Unknown keys are ignored.

# Address the server binds to. Keep 127.0.0.1 unless you know you need another interface.
LANGUAGE_LAB_HOST=127.0.0.1

# Port the server listens on.
LANGUAGE_LAB_PORT=8787

# Hostname the app is reached by from other devices, e.g. your Tailscale name
# (mac-mini.tailnet-name.ts.net). Leave empty if you only use it on this machine.
LANGUAGE_LAB_PUBLIC_HOST=

# Dev mode: read ./.env instead of ~/.config/language-lab/.env. Set it in the process env
# (LANGUAGE_LAB_DEV=1 uv run language-lab), not here. In dev mode ANKI_PREFIX may not be
# LanguageLab in any letter case, so dev work never touches your real decks.
# LANGUAGE_LAB_DEV=1

# AnkiConnect endpoint (the AnkiConnect add-on's default).
ANKI_CONNECT_URL=http://127.0.0.1:8765

# Prefix for every deck and note type LanguageLab creates: a letter, then letters or digits
# only (^[A-Za-z][A-Za-z0-9]*$). Use LanguageLab for release and e.g. LanguageLabDev for dev.
ANKI_PREFIX=LanguageLab

# Azure Speech key (secret).
AZURE_SPEECH_KEY=

# Azure Speech region, e.g. westeurope.
AZURE_SPEECH_REGION=

# OpenRouter API key (secret).
OPENROUTER_API_KEY=

# OpenRouter models to use, comma-separated, in order of preference. These IDs are examples:
# every model must support strict JSON Schema output, so evaluate one before configuring it.
OPENROUTER_MODELS=openai/gpt-5.6-luna,google/gemini-3.5-flash-lite,anthropic/claude-sonnet-4.6
